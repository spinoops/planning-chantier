# =============================================================================
#  Configuration de PRODUCTION (Infomaniak mutualisé)
#  Copier ce fichier en .env SUR LE SERVEUR, puis completer les valeurs.
#  Ne JAMAIS committer le .env reel (secrets).
#  Guide : DEPLOY.md, § 5 « Première mise en ligne ».
# =============================================================================

APP_NAME="Planning Chantier"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Europe/Zurich

# Un seul domaine : interface React + API (doc root -> backend/public).
APP_URL=https://planning.top-stores.ch
FRONTEND_URL=https://planning.top-stores.ch
SANCTUM_STATEFUL_DOMAINS=planning.top-stores.ch

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=error

# --- Base MySQL Infomaniak (Manager > Hebergement > Bases de donnees) ---
DB_CONNECTION=mysql
DB_HOST=xxxxx.myd.infomaniak.com
DB_PORT=3306
DB_DATABASE=xxxxx_planning
DB_USERNAME=xxxxx_planning
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# Aucun worker de file d'attente sur le mutualisé : tout part tout de suite.
QUEUE_CONNECTION=sync
CACHE_STORE=database

# Connexions des téléphones / tablettes : expirent après 60 jours (minutes).
SANCTUM_EXPIRATION=86400

# --- Mail (e-mails « mot de passe oublié », invitations, alertes planning) ---
MAIL_MAILER=smtp
MAIL_HOST=mail.infomaniak.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@top-stores.ch"
MAIL_FROM_NAME="${APP_NAME}"

# --- Sauvegardes (storage/app/backups) ---
BACKUP_DISK=local
BACKUP_PATH=backups
BACKUP_KEEP=30
# Si mysqldump n'est pas dans le PATH du serveur (sinon repli automatique en PHP) :
# BACKUP_MYSQLDUMP=/usr/bin/mysqldump

# --- Tâche planifiée par URL : /api/cron/run/<CRON_TOKEN> (rappels, sauvegarde) ---
# Générer : php -r 'echo bin2hex(random_bytes(24)), PHP_EOL;'
CRON_TOKEN=
# Tolérance des rappels push en minutes (couvre l'intervalle entre deux appels).
CRON_REMIND_GRACE=20

# --- Notifications push (Web Push) ---
# Générer UNE SEULE FOIS sur le serveur : php backend/artisan webpush:vapid
# Ne jamais les régénérer (tous les téléphones devraient se réabonner).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:noreply@top-stores.ch"

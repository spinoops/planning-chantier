# =============================================================================
#  Configuration de PRODUCTION
#  Copier ce fichier en .env SUR LE SERVEUR, puis completer les valeurs.
#  Ne JAMAIS committer le .env reel (secrets).
# =============================================================================

APP_NAME="Mon App"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
# URL de l'API (doc root -> backend/public)
APP_URL=https://api.mon-domaine.tld

# URL de la SPA React : utilisee pour le CORS et les liens (reset password).
FRONTEND_URL=https://mon-domaine.tld
SANCTUM_STATEFUL_DOMAINS=mon-domaine.tld

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# --- Base MySQL Infomaniak (Manager > Hebergement > Bases de donnees) ---
DB_CONNECTION=mysql
DB_HOST=xxxxx.myd.infomaniak.com
DB_PORT=3306
DB_DATABASE=xxxxx_nom
DB_USERNAME=xxxxx_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Mail (adapter a ton fournisseur) ---
MAIL_MAILER=smtp
MAIL_HOST=mail.infomaniak.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@mon-domaine.tld"
MAIL_FROM_NAME="${APP_NAME}"

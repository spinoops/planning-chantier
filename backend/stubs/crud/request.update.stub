<?php

namespace App\Http\Requests;

use Illuminate\Foundation\Http\FormRequest;

class Update{{ class }}Request extends FormRequest
{
    /**
     * L'accès est filtré par les middlewares de la route (auth / admin).
     * Affine ici avec une Policy si besoin : $this->user()->can('update', $this->route('{{ variable }}')).
     */
    public function authorize(): bool
    {
        return true;
    }

    /**
     * Mise à jour partielle acceptée (`sometimes`) : PATCH ou PUT.
     *
     * @return array<string, mixed>
     */
    public function rules(): array
    {
        return [
{{ updateRules }}
        ];
    }
}

# URL de l'API Laravel (sans /api). Doit correspondre à APP_URL de backend/.env.
VITE_API_URL=http://localhost:8000

# Port du serveur de dev Vite. Donne un port différent à chaque projet dérivé
# (new-project.ps1 -FrontPort) pour lancer plusieurs projets en même temps.
VITE_PORT=5173

# Clé de licence FullCalendar Scheduler (vue « Par ouvrier », plugin premium).
# Vide = clé d'évaluation CC-Attribution-NonCommercial-NoDerivatives (usage non commercial).
VITE_FC_LICENSE_KEY=
